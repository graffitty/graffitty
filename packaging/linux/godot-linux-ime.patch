+bool WaylandThread::window_is_focused(DisplayServerEnums::WindowID p_window_id) const {
+	// Keyboard focus, as on the other platforms. The pointer can rest on
+	// another surface while this window receives keys and text input.
+	for (struct wl_seat *wl_seat : registry.wl_seats) {
+		SeatState *ss = wl_seat_get_seat_state(wl_seat);
+		if (ss && ss->focused_id == p_window_id) {
+			return true;
+		}
+	}
+	return false;
+}
